{
  "name": "journey-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format": "prettier --check \"{src,test,db}/**/*.{ts,js,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"{src,test,db}/**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "jest --config ./test/jest.config.ts --runInBand",
    "test:unit": "jest --config ./test/jest.unit.config.ts --runInBand",
    "test:integration": "jest --config ./test/jest.integration.config.ts --runInBand",
    "prisma:generate": "prisma generate --schema db/schema.prisma",
    "prisma:validate": "prisma validate --schema db/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema db/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\\\TrungDang\\\\journey\\\\backend\\\\scripts\\\\windows\\\\run-personal-server.ps1\"",
    "down": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\\\TrungDang\\\\journey\\\\backend\\\\scripts\\\\windows\\\\stop-personal-server.ps1\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.23.0"
  }
}
