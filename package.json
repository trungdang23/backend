{
  "name": "journey-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format": "prettier --check \"{src,test,db}/**/*.{ts,js,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"{src,test,db}/**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "pnpm test:prepare-db && jest --config ./test/jest.config.ts --runInBand",
    "test:prepare-db": "bash ./scripts/prepare-test-db.sh",
    "test:unit": "jest --config ./test/jest.unit.config.ts --runInBand",
    "test:integration": "pnpm test:prepare-db && jest --config ./test/jest.integration.config.ts --runInBand",
    "test:e2e": "pnpm test:prepare-db && jest --config ./test/jest.e2e.config.ts --runInBand",
    "migrate:itinerary-to-plan-nodes": "ts-node ./scripts/migrate-itinerary-to-plan-nodes.ts",
    "prisma:generate": "prisma generate --schema db/schema.prisma",
    "prisma:validate": "prisma validate --schema db/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema db/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\\\TrungDang\\\\journey\\\\backend\\\\scripts\\\\windows\\\\run-personal-server.ps1\"",
    "down": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\\\TrungDang\\\\journey\\\\backend\\\\scripts\\\\windows\\\\stop-personal-server.ps1\"",
    "status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\\\TrungDang\\\\journey\\\\backend\\\\scripts\\\\windows\\\\status-personal-server.ps1\"",
    "u": "pnpm run up",
    "d": "pnpm run down",
    "s": "pnpm run status",
    "stack:up": "bash ./scripts/ops/up-all.sh",
    "stack:down": "bash ./scripts/ops/down-all.sh",
    "stack:status": "bash ./scripts/ops/status-all.sh",
    "ua": "pnpm run stack:up",
    "da": "pnpm run stack:down",
    "sa": "pnpm run stack:status"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.17",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.8.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
