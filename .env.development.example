NODE_ENV=development
APP_NAME=journey-backend
APP_PORT=3001
GLOBAL_PREFIX=api/v1
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://journey:journey@localhost:5432/journey?schema=public
JWT_ISSUER=journey.local
JWT_ACCESS_TOKEN_SECRET=journey-development-access-token-secret-12345
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_SECRET=journey-development-refresh-token-secret-12345
JWT_REFRESH_TOKEN_TTL=7d
