generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  trips        Trip[]

  @@map("users")
}

model Trip {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  destination          String?
  summaryNotes         String?  @map("summary_notes")
  coverImageUrl        String?  @map("cover_image_url")
  startDate            String   @map("start_date")
  endDate              String   @map("end_date")
  timezone             String?
  budgetAmount         Int      @map("budget_amount")
  budgetCurrency       String   @map("budget_currency")
  budgetMode           String   @default("manual") @map("budget_mode")
  manualBudgetAmount   Int?     @map("manual_budget_amount")
  manualBudgetCurrency String?  @map("manual_budget_currency")
  visibility           String   @default("private")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  itineraryDays        TripItineraryDay[]

  @@index([userId, startDate])
  @@map("trips")
}

model TripItineraryDay {
  id         String                 @id @default(cuid())
  tripId     String                 @map("trip_id")
  trip       Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date       String
  title      String
  startsAt   String?                @map("starts_at")
  endsAt     String?                @map("ends_at")
  location   String?
  notes      String?
  costAmount Int                    @default(0) @map("cost_amount")
  costCurrency String               @map("cost_currency")
  position   Int
  imageUrls  String[]               @default([]) @map("image_urls")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  activities TripItineraryActivity[]

  @@unique([tripId, date, position])
  @@index([tripId, date, position])
  @@map("trip_itinerary_days")
}

model TripItineraryActivity {
  id             String           @id @default(cuid())
  itineraryDayId String           @map("itinerary_day_id")
  itineraryDay   TripItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  title          String
  startsAt       String?          @map("starts_at")
  endsAt         String?          @map("ends_at")
  location       String?
  notes          String?
  costAmount     Int              @default(0) @map("cost_amount")
  costCurrency   String           @map("cost_currency")
  position       Int
  imageUrls      String[]         @default([]) @map("image_urls")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([itineraryDayId, position])
  @@index([itineraryDayId, position])
  @@map("trip_itinerary_activities")
}
