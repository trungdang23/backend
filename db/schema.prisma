generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String             @map("password_hash")
  displayName       String?            @map("display_name")
  avatarFileName    String?            @map("avatar_file_name")
  avatarContentType String?            @map("avatar_content_type")
  avatarByteSize    Int?               @map("avatar_byte_size")
  avatarStorageKey  String?            @unique @map("avatar_storage_key")
  avatarPublicId    String?            @unique @map("avatar_public_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  trips             Trip[]
  posts             Post[]
  journalAssets     TripJournalAsset[]

  @@map("users")
}

model Trip {
  id                   String             @id @default(cuid())
  userId               String             @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  destination          String?
  summaryNotes         String?            @map("summary_notes")
  coverImageUrl        String?            @map("cover_image_url")
  startDate            String             @map("start_date")
  endDate              String             @map("end_date")
  timezone             String?
  budgetAmount         Int                @map("budget_amount")
  budgetCurrency       String             @map("budget_currency")
  budgetMode           String             @default("manual") @map("budget_mode")
  manualBudgetAmount   Int?               @map("manual_budget_amount")
  manualBudgetCurrency String?            @map("manual_budget_currency")
  visibility           String             @default("private")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  planNodes            PlanNode[]
  journal              TripJournal?
  journalRevisions     TripJournalRevision[]
  journalAssets        TripJournalAsset[]
  posts                Post[]

  @@index([userId, startDate])
  @@map("trips")
}

model TripJournal {
  id           String   @id @default(cuid())
  tripId       String   @unique @map("trip_id")
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sceneVersion Int      @default(1) @map("scene_version")
  page         Json
  objects      Json
  visibility   String   @default("private")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trip_journals")
}

model TripJournalRevision {
  id           String   @id @default(cuid())
  tripId       String   @map("trip_id")
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sceneVersion Int      @default(1) @map("scene_version")
  page         Json
  objects      Json
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tripId, createdAt])
  @@map("trip_journal_revisions")
}

model TripJournalAsset {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  storageKey  String   @unique @map("storage_key")
  publicId    String   @unique @map("public_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tripId, createdAt])
  @@index([userId, createdAt])
  @@map("trip_journal_assets")
}

model Post {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId        String?  @map("trip_id")
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  title         String
  content       String
  coverImageUrl String?  @map("cover_image_url")
  visibility    String   @default("public")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([tripId])
  @@map("posts")
}

enum PlanNodeType {
  section
  day
  location
  activity
  note

  @@map("plan_node_type")
}

model PlanNode {
  id           String            @id @default(cuid())
  tripId       String            @map("trip_id")
  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  parentId     String?           @map("parent_id")
  parent       PlanNode?         @relation("PlanNodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     PlanNode[]        @relation("PlanNodeHierarchy")
  stickers     PlanNodeSticker[]
  type         PlanNodeType
  title        String
  notes        String?
  startAt      String?           @map("start_at")
  endAt        String?           @map("end_at")
  costAmount   Int?              @map("cost_amount")
  costCurrency String?           @map("cost_currency")
  imageUrl     String?           @map("image_url")
  sortOrder    Int               @map("sort_order")
  depth        Int
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([tripId, parentId, sortOrder])
  @@index([tripId, depth])
  @@map("plan_nodes")
}

model PlanNodeSticker {
  id         String   @id @default(cuid())
  nodeId     String   @map("node_id")
  node       PlanNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  stickerKey String   @map("sticker_key")
  x          Int
  y          Int
  rotation   Int      @default(0)
  scale      Int      @default(100)
  zIndex     Int      @default(0) @map("z_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([nodeId, zIndex])
  @@map("plan_node_stickers")
}
