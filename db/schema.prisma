generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  trips        Trip[]
  posts        Post[]

  @@map("users")
}

model Trip {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  destination          String?
  summaryNotes         String?  @map("summary_notes")
  coverImageUrl        String?  @map("cover_image_url")
  startDate            String   @map("start_date")
  endDate              String   @map("end_date")
  timezone             String?
  budgetAmount         Int      @map("budget_amount")
  budgetCurrency       String   @map("budget_currency")
  budgetMode           String   @default("manual") @map("budget_mode")
  manualBudgetAmount   Int?     @map("manual_budget_amount")
  manualBudgetCurrency String?  @map("manual_budget_currency")
  visibility           String   @default("private")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  itineraryDays        TripItineraryDay[]
  planNodes            PlanNode[]
  journal              TripJournal?
  posts                Post[]

  @@index([userId, startDate])
  @@map("trips")
}

model TripJournal {
  id           String   @id @default(cuid())
  tripId       String   @unique @map("trip_id")
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sceneVersion Int      @default(1) @map("scene_version")
  page         Json
  objects      Json
  visibility   String   @default("private")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trip_journals")
}

model Post {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId        String?  @map("trip_id")
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  title         String
  content       String
  coverImageUrl String?  @map("cover_image_url")
  visibility    String   @default("public")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([tripId])
  @@map("posts")
}

enum PlanNodeType {
  section
  day
  location
  activity
  note

  @@map("plan_node_type")
}

model PlanNode {
  id           String       @id @default(cuid())
  tripId       String       @map("trip_id")
  trip         Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  parentId     String?      @map("parent_id")
  parent       PlanNode?    @relation("PlanNodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     PlanNode[]   @relation("PlanNodeHierarchy")
  stickers     PlanNodeSticker[]
  type         PlanNodeType
  title        String
  notes        String?
  startAt      String?      @map("start_at")
  endAt        String?      @map("end_at")
  costAmount   Int?         @map("cost_amount")
  costCurrency String?      @map("cost_currency")
  imageUrl     String?      @map("image_url")
  sortOrder    Int          @map("sort_order")
  depth        Int
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([tripId, parentId, sortOrder])
  @@index([tripId, depth])
  @@map("plan_nodes")
}

model PlanNodeSticker {
  id         String   @id @default(cuid())
  nodeId     String   @map("node_id")
  node       PlanNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  stickerKey String   @map("sticker_key")
  x          Int
  y          Int
  rotation   Int      @default(0)
  scale      Int      @default(100)
  zIndex     Int      @default(0) @map("z_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([nodeId, zIndex])
  @@map("plan_node_stickers")
}

model TripItineraryDay {
  id         String                 @id @default(cuid())
  tripId     String                 @map("trip_id")
  trip       Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date       String
  title      String
  startsAt   String?                @map("starts_at")
  endsAt     String?                @map("ends_at")
  location   String?
  notes      String?
  costAmount Int                    @default(0) @map("cost_amount")
  costCurrency String               @map("cost_currency")
  position   Int
  imageUrls  String[]               @default([]) @map("image_urls")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  activities TripItineraryActivity[]

  @@unique([tripId, date, position])
  @@index([tripId, date, position])
  @@map("trip_itinerary_days")
}

model TripItineraryActivity {
  id             String           @id @default(cuid())
  itineraryDayId String           @map("itinerary_day_id")
  itineraryDay   TripItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  title          String
  startsAt       String?          @map("starts_at")
  endsAt         String?          @map("ends_at")
  location       String?
  notes          String?
  costAmount     Int              @default(0) @map("cost_amount")
  costCurrency   String           @map("cost_currency")
  position       Int
  imageUrls      String[]         @default([]) @map("image_urls")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([itineraryDayId, position])
  @@index([itineraryDayId, position])
  @@map("trip_itinerary_activities")
}
