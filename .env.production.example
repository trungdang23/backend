# Reference only. Keep real production values in GitHub Secrets/Variables.
# The deploy workflow will render `.env.production` on the target machine.
NODE_ENV=production
APP_NAME=journey-backend
APP_PORT=3001
GLOBAL_PREFIX=api/v1
SWAGGER_ENABLED=true
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
CORS_ALLOWED_ORIGINS=https://buicojourney.com,https://www.buicojourney.com
DATABASE_URL=postgresql://journey:change-me@db:5432/journey?schema=public
JWT_ISSUER=api.buicojourney.com
JWT_ACCESS_TOKEN_SECRET=change-me-with-64-plus-random-characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_SECRET=change-me-with-another-64-plus-random-characters
JWT_REFRESH_TOKEN_TTL=7d
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
JOURNAL_ASSET_SIGNING_SECRET=change-me-with-64-plus-random-characters
JOURNAL_ASSET_SIGNED_URL_TTL_SECONDS=900
